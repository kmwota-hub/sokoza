# SOKOZA Environment Configuration

# Server
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
APP_URL=http://localhost:5173
# On Render, set APP_URL=https://sokoza-api.vercel.app and allow that origin:
# CORS_ORIGINS=https://sokoza-api.vercel.app
EMAIL_FROM="SOKOZA <noreply@example.com>"

# Database (PostgreSQL; configure this on the API host)
DATABASE_URL="postgresql://sokoza_user:sokoza_password@localhost:5432/sokoza_db?schema=public"

# Dedicated database for destructive DB-backed integration tests
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/sokoza_test?schema=public"

# Authentication
JWT_ACCESS_SECRET="sokoza_super_secret_access_key_change_in_production"
JWT_REFRESH_SECRET="sokoza_super_secret_refresh_key_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment - M-Pesa (Kenya Safaricom Daraja API)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY="your_mpesa_consumer_key"
MPESA_CONSUMER_SECRET="your_mpesa_consumer_secret"
MPESA_PASSKEY="your_mpesa_passkey"
MPESA_SHORTCODE="174379"
MPESA_CALLBACK_URL="https://api.sokoza.co.ke/api/v1/payments/mpesa/callback"

# Storage
STORAGE_URL="http://localhost:3001/uploads"
STORAGE_ACCESS_KEY="minio_or_s3_key"
STORAGE_SECRET_KEY="minio_or_s3_secret"

# Maps & Location Services
MAPS_API_KEY="your_google_maps_or_mapbox_key"
DEFAULT_LOCATION_LAT="-1.1026"
DEFAULT_LOCATION_LNG="37.0132"
DEFAULT_LOCATION_CITY="Juja"
DEFAULT_LOCATION_COUNTRY="Kenya"

# Communication
RESEND_API_KEY="your_resend_api_key"
SMS_API_KEY="your_africastalking_sms_key"
