// SOKOZA Production Prisma Schema (PostgreSQL)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum RoleName {
  CUSTOMER
  BUSINESS_OWNER
  BUSINESS_STAFF
  RIDER
  ADMIN
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum DeliveryMode {
  OWN_RIDERS
  PLATFORM_RIDERS
  BOTH
}

enum BusinessMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum RiderType {
  PLATFORM
  BUSINESS
  BOTH
}

enum RiderAvailabilityStatus {
  ONLINE
  OFFLINE
  BUSY
  SUSPENDED
}

enum RiderVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RiderDocumentType {
  NATIONAL_ID
  DRIVING_LICENCE
  VEHICLE_DOCUMENT
  INSURANCE
}

enum DeliveryType {
  BUSINESS_RIDER
  PLATFORM_RIDER
  CUSTOMER_PICKUP
}

enum DeliveryStatus {
  PENDING
  SEARCHING_RIDER
  RIDER_ASSIGNED
  RIDER_ACCEPTED
  ARRIVED_AT_PICKUP
  PICKED_UP
  IN_TRANSIT
  ARRIVED_AT_DESTINATION
  DELIVERED
  FAILED
  CANCELLED
}

enum DeliveryRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  MPESA
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum FeatureCategory {
  BUSINESS
  DELIVERY
  PAYMENT
  CUSTOMER
  PRODUCT
  REPORTING
  COMMUNICATION
  OTHER
}

enum FeatureRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  PLANNED
  IN_DEVELOPMENT
  COMPLETED
  DECLINED
}

enum DisputeReason {
  PRODUCT_MISSING
  WRONG_PRODUCT
  DAMAGED_PRODUCT
  LATE_DELIVERY
  PAYMENT_PROBLEM
  RIDER_ISSUE
  BUSINESS_ISSUE
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

// ----------------------------------------------------
// USERS & AUTHORIZATION
// ----------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  firstName    String
  lastName     String
  email        String     @unique
  phone        String     @unique
  passwordHash String
  profileImage String?
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles           UserRole[]
  businessesOwned     Business[]           @relation("BusinessOwner")
  businessMemberships BusinessMember[]
  addresses           Address[]
  carts               Cart[]
  orders              Order[]              @relation("CustomerOrders")
  riderProfile        Rider?
  reviews             Review[]
  notifications       Notification[]
  deviceTokens        DeviceToken[]
  featureRequests     FeatureRequest[]
  featureVotes        FeatureRequestVote[]
  auditLogs           AuditLog[]
  disputes            Dispute[]            @relation("CreatedDisputes")
  resolvedDisputes    Dispute[]            @relation("ResolvedDisputes")
  verifiedDocuments   RiderDocument[]      @relation("AdminVerifiedDoc")
}

model Role {
  id   String   @id @default(uuid()) @db.Uuid
  name RoleName @unique

  userRoles UserRole[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ----------------------------------------------------
// BUSINESSES & MEMBERS
// ----------------------------------------------------

model Business {
  id             String         @id @default(uuid()) @db.Uuid
  ownerId        String         @db.Uuid
  businessName   String
  slug           String         @unique
  description    String
  phone          String
  email          String
  logo           String?
  coverImage     String?
  address        String
  area           String
  latitude       Decimal        @db.Decimal(10, 8)
  longitude      Decimal        @db.Decimal(11, 8)
  businessStatus BusinessStatus @default(PENDING)
  deliveryMode   DeliveryMode   @default(BOTH)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner            User             @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members          BusinessMember[]
  products         Product[]
  carts            Cart[]
  orders           Order[]
  businessRiders   BusinessRider[]
  deliveryRequests DeliveryRequest[]
  reviews          Review[]
  commissions      Commission[]
}

model BusinessMember {
  id         String             @id @default(uuid()) @db.Uuid
  businessId String             @db.Uuid
  userId     String             @db.Uuid
  role       BusinessMemberRole @default(STAFF)

  joinedAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
}

// ----------------------------------------------------
// CATEGORIES, PRODUCTS & INVENTORY
// ----------------------------------------------------

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  image       String?
  parentId    String?  @db.Uuid
  status      String   @default("ACTIVE")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]
}

model Product {
  id            String        @id @default(uuid()) @db.Uuid
  businessId    String        @db.Uuid
  categoryId    String        @db.Uuid
  name          String
  slug          String
  description   String
  price         Decimal       @db.Decimal(12, 2)
  discountPrice Decimal?      @db.Decimal(12, 2)
  sku           String
  status        ProductStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category  Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images    ProductImage[]
  inventory Inventory?
  cartItems CartItem[]

  @@unique([businessId, sku])
}

model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  imageUrl  String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Inventory {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @unique @db.Uuid
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// ADDRESSES, CART & CART ITEMS
// ----------------------------------------------------

model Address {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  label        String
  addressLine  String
  area         String
  building     String?
  latitude     Decimal  @db.Decimal(10, 8)
  longitude    Decimal  @db.Decimal(11, 8)
  instructions String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

model Cart {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  businessId String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@unique([userId, businessId])
}

model CartItem {
  id        String  @id @default(uuid()) @db.Uuid
  cartId    String  @db.Uuid
  productId String  @db.Uuid
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

// ----------------------------------------------------
// ORDERS & ORDER ITEMS
// ----------------------------------------------------

model Order {
  id                String        @id @default(uuid()) @db.Uuid
  orderNumber       String        @unique
  customerId        String        @db.Uuid
  businessId        String        @db.Uuid
  subtotal          Decimal       @db.Decimal(12, 2)
  deliveryFee       Decimal       @db.Decimal(12, 2)
  discount          Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal       @db.Decimal(12, 2)
  paymentStatus     PaymentStatus @default(PENDING)
  orderStatus       OrderStatus   @default(PENDING)
  deliveryAddressId String        @db.Uuid
  customerNotes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer User        @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  business Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  address  Address     @relation(fields: [deliveryAddressId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  delivery Delivery?
  payments Payment[]
  reviews  Review[]
  disputes Dispute[]
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @db.Uuid
  productId   String  @db.Uuid
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// RIDERS, DOCUMENTS & AVAILABILITY
// ----------------------------------------------------

model Rider {
  id                   String                  @id @default(uuid()) @db.Uuid
  userId               String                  @unique @db.Uuid
  riderType            RiderType               @default(PLATFORM)
  vehicleType          String
  vehicleRegistration  String
  phone                String
  rating               Decimal                 @default(5.0) @db.Decimal(3, 2)
  totalDeliveries      Int                     @default(0)
  verificationStatus   RiderVerificationStatus @default(PENDING)
  availabilityStatus   RiderAvailabilityStatus @default(OFFLINE)
  currentLatitude      Decimal?                @db.Decimal(10, 8)
  currentLongitude     Decimal?                @db.Decimal(11, 8)
  deliveryRadius       Decimal                 @default(15.0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  documents        RiderDocument[]
  availability     RiderAvailability[]
  businessRiders   BusinessRider[]
  deliveries       Delivery[]
  deliveryRequests DeliveryRequest[]
  reviews          Review[]
  payouts          Payout[]
}

model RiderDocument {
  id                 String                  @id @default(uuid()) @db.Uuid
  riderId            String                  @db.Uuid
  documentType       RiderDocumentType
  documentNumber     String
  documentUrl        String
  verificationStatus RiderVerificationStatus @default(PENDING)
  verifiedById       String?                 @db.Uuid
  verifiedAt         DateTime?

  rider      Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("AdminVerifiedDoc", fields: [verifiedById], references: [id], onDelete: SetNull)
}

model RiderAvailability {
  id          String  @id @default(uuid()) @db.Uuid
  riderId     String  @db.Uuid
  dayOfWeek   Int // 0 (Sun) - 6 (Sat)
  startTime   String // "08:00"
  endTime     String // "18:00"
  isAvailable Boolean @default(true)

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)
}

model BusinessRider {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  riderId    String   @db.Uuid
  status     String   @default("ACTIVE")
  joinedAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rider    Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@unique([businessId, riderId])
}

// ----------------------------------------------------
// DELIVERIES & REQUESTS
// ----------------------------------------------------

model Delivery {
  id           String       @id @default(uuid()) @db.Uuid
  orderId      String       @unique @db.Uuid
  deliveryType DeliveryType @default(PLATFORM_RIDER)
  riderId      String?      @db.Uuid

  pickupAddress   String
  pickupLatitude  Decimal @db.Decimal(10, 8)
  pickupLongitude Decimal @db.Decimal(11, 8)

  deliveryAddress   String
  deliveryLatitude  Decimal @db.Decimal(10, 8)
  deliveryLongitude Decimal @db.Decimal(11, 8)

  deliveryFee Decimal        @db.Decimal(12, 2)
  status      DeliveryStatus @default(PENDING)

  requestedAt DateTime?
  acceptedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  rider       Rider?            @relation(fields: [riderId], references: [id], onDelete: SetNull)
  requests    DeliveryRequest[]
  commissions Commission[]
}

model DeliveryRequest {
  id          String                @id @default(uuid()) @db.Uuid
  deliveryId  String                @db.Uuid
  businessId  String                @db.Uuid
  riderId     String                @db.Uuid
  distance    Decimal               @db.Decimal(8, 2)
  offeredFee  Decimal               @db.Decimal(12, 2)
  status      DeliveryRequestStatus @default(PENDING)
  requestedAt DateTime              @default(now())
  respondedAt DateTime?
  expiresAt   DateTime

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rider    Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// PAYMENTS & TRANSACTIONS
// ----------------------------------------------------

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @db.Uuid
  customerId    String        @db.Uuid
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("KES")
  paymentMethod PaymentMethod @default(MPESA)
  status        PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transactions PaymentTransaction[]
}

model PaymentTransaction {
  id                   String   @id @default(uuid()) @db.Uuid
  paymentId            String   @db.Uuid
  provider             String // "MPESA", "STRIPE", "CASH"
  transactionReference String   @unique
  providerReference    String?
  amount               Decimal  @db.Decimal(12, 2)
  status               String
  rawResponse          Json?
  createdAt            DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// REVIEWS, NOTIFICATIONS, COMMISSIONS, PAYOUTS
// ----------------------------------------------------

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  orderId    String   @db.Uuid
  businessId String   @db.Uuid
  riderId    String?  @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  customer User     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  rider    Rider?   @relation(fields: [riderId], references: [id], onDelete: SetNull)

  @@unique([customerId, orderId])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  platform  String   // "web", "android", "ios"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Commission {
  id                 String   @id @default(uuid()) @db.Uuid
  orderId            String   @db.Uuid
  businessId         String   @db.Uuid
  deliveryId         String   @db.Uuid
  platformFee        Decimal  @db.Decimal(12, 2)
  businessCommission Decimal  @db.Decimal(12, 2)
  riderCommission    Decimal  @db.Decimal(12, 2)
  createdAt          DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
}

model Payout {
  id            String    @id @default(uuid()) @db.Uuid
  riderId       String    @db.Uuid
  amount        Decimal   @db.Decimal(12, 2)
  paymentMethod String    @default("MPESA")
  status        String    @default("PENDING")
  reference     String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Restrict)
}

model Dispute {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @db.Uuid
  createdBy   String        @db.Uuid
  reason      DisputeReason
  description String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  resolvedBy  String?       @db.Uuid
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  order        Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  creator      User  @relation("CreatedDisputes", fields: [createdBy], references: [id], onDelete: Restrict)
  resolverUser User? @relation("ResolvedDisputes", fields: [resolvedBy], references: [id], onDelete: SetNull)
}

// ----------------------------------------------------
// FEATURE REQUESTS & VOTING
// ----------------------------------------------------

model FeatureRequest {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @db.Uuid
  title         String
  description   String
  category      FeatureCategory
  status        FeatureRequestStatus @default(SUBMITTED)
  adminResponse String?
  voteCount     Int                  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  votes FeatureRequestVote[]
}

model FeatureRequestVote {
  id               String   @id @default(uuid()) @db.Uuid
  featureRequestId String   @db.Uuid
  userId           String   @db.Uuid
  createdAt        DateTime @default(now())

  featureRequest FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([featureRequestId, userId])
}

// ----------------------------------------------------
// AUDIT LOGS
// ----------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  oldData    Json?
  newData    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
